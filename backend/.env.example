APP_NAME=SignalSafe API
ENVIRONMENT=development
DATABASE_URL=sqlite:///./data/local.db
JWT_SECRET=replace-this-in-a-real-environment
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
COOKIE_SECURE=false
SEED_DEMO_DATA=true
DEMO_REVIEWER_PASSWORD=reviewer
# Shared with harmwatch (SIGNALSAFE_INGEST_TOKEN in the root .env). Empty disables POST /api/detections.
INGEST_TOKEN=
