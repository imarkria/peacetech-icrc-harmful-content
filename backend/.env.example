APP_NAME=SignalSafe API
ENVIRONMENT=development
DATABASE_URL=sqlite:///./data/local.db
JWT_SECRET=replace-this-in-a-real-environment
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
COOKIE_SECURE=false
SEED_DEMO_DATA=true
# Password of the demo reviewer (reviewer@icrc.org) and demo volunteer (volunteer@icrc.org)
DEMO_PASSWORD=reviewer
# Shared with harmwatch (SIGNALSAFE_INGEST_TOKEN in the root .env). Empty disables POST /api/detections
# and model screening of community reports (they then go straight to the queue).
INGEST_TOKEN=
# Community reports per client IP (<count>/<seconds>), and how long a report waits for model screening
REPORT_RATE_LIMIT=5/600
SCREENING_TIMEOUT_MINUTES=30
