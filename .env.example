# Copy to .env (never commit .env)

# Classifier: auto (Claude if ANTHROPIC_API_KEY is set, else keywords) | claude | local | keywords
CLASSIFIER=auto
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5

# Local open model (scripts/serve_llm.sh) and policy layers (policy/README.md)
LOCAL_LLM_URL=http://127.0.0.1:8080/v1
LOCAL_LLM_MODEL=qwen3.5-9b
REGION=ru_ua
PLATFORM=telegram

# Password for the ICRC analyst account in the web app
ICRC_PASSWORD=demo

# Telegram collector (https://my.telegram.org)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_CHANNELS=channel_one,channel_two

# Volunteer bot (@BotFather)
TELEGRAM_BOT_TOKEN=
