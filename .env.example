# Copy to .env (never commit .env)

# Classifier: auto (Claude if ANTHROPIC_API_KEY is set, else keywords) | claude | keywords
CLASSIFIER=auto
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5

# Password for the ICRC analyst account in the web app
ICRC_PASSWORD=demo

# Telegram collector (https://my.telegram.org)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_CHANNELS=channel_one,channel_two

# Volunteer bot (@BotFather)
TELEGRAM_BOT_TOKEN=
