# Copy to .env (never commit .env)

# Classifier: local = our Qwen model (needs scripts/serve_llm.sh on a GPU) | keywords = offline baseline for tests/demos
CLASSIFIER=local

# Local open model (scripts/serve_llm.sh) and policy layers (policy/README.md)
LOCAL_LLM_URL=http://127.0.0.1:8080/v1
LOCAL_LLM_MODEL=qwen3.5-9b
REGION=ru_ua
PLATFORM=telegram

# Telegram collector (https://my.telegram.org)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_CHANNELS=channel_one,channel_two

# Community Telegram bot, anonymous reports (@BotFather): python -m harmwatch.bot
TELEGRAM_BOT_TOKEN=

# Apify (Facebook, Instagram, TikTok, X): python -m harmwatch.social
APIFY_TOKEN=

# SignalSafe backend: `python -m harmwatch.publish` sends flagged posts to its review queue.
# The token must match INGEST_TOKEN in backend/.env.
SIGNALSAFE_API_URL=http://localhost:8000
SIGNALSAFE_INGEST_TOKEN=
